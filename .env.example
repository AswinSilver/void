# =============================================================================
# VOID - Phishing Investigation Platform
# Environment Variables
# =============================================================================

# ---- General ----
ENVIRONMENT=development
DEBUG=true

# ---- Database ----
POSTGRES_USER=void_user
POSTGRES_PASSWORD=void_password
POSTGRES_DB=void_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://void_user:void_password@localhost:5432/void_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- MinIO / S3 ----
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=void_minio_user
MINIO_ROOT_PASSWORD=void_minio_password
MINIO_BUCKET_EMAILS=void-emails
MINIO_BUCKET_SCREENSHOTS=void-screenshots
MINIO_BUCKET_REPORTS=void-reports
MINIO_BUCKET_ATTACHMENTS=void-attachments
MINIO_USE_SSL=false

# ---- Auth ----
SECRET_KEY=change-this-to-a-very-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- AI Models ----
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEFAULT_AI_PROVIDER=openai   # openai | gemini | groq

# ---- Threat Intelligence APIs ----
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_API_KEY=
HAVE_I_BEEN_PWNED_API_KEY=

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
